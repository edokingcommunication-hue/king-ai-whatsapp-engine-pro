# Required secrets: generate strong random values; never commit real values.
ENGINE_API_KEY=replace_with_a_long_random_secret
WHATSAPP_WEBHOOK_TOKEN=replace_with_another_long_random_secret

# Optional: Base44 webhook endpoint, if your app exposes one.
BASE44_WEBHOOK_URL=

# Railway persistent volume should be mounted at /data.
SESSION_DIR=/data/sessions
LOG_LEVEL=info